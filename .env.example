# ─────────────────────────────────────────────────────────────────────────────
# Estimator AI — copy to .env.local and fill in your keys
# ─────────────────────────────────────────────────────────────────────────────

# Provider: openai | gemini  (auto-detects gemini if only GEMINI_API_KEY is set)
LLM_PROVIDER=gemini

# Gemini (for testing)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# OpenAI (production)
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PORT=3000

# ── Workflow ─────────────────────────────────────────────────────────────────
# Madeira / Direct Shades: upload all three Excel files together —
#   Window Matrix   → shade COUNT authority (TOTAL row → TOTAL SHADES column)
#                     plus Blind QTY UNITS sheets for per-opening W×H
#   Material Summary→ fabric and system selection per tab (UNITS, BLK, COM-*)
#   Bid Summary     → REFERENCE PRICING only; dollars never change the count
#
# Two routes exist and the server picks one automatically:
#   Workbook fast path — an Excel-only upload whose Window Matrix has a TOTAL row.
#     Vision and the RAG index are skipped; take-off and pricing are deterministic
#     Python, and the model only writes the client-facing prose.
#   Full analysis — anything with a PDF or image, or without a Matrix TOTAL row.
#     Vision reads every page, the document is embedded for retrieval, and the
#     model performs the take-off before pricing.
#
# Check which route ran in the response: projectSummary.route, and confirm the
# counts agree via projectSummary.matchStatus.

# ── Deterministic pricing (workbook fast path) ───────────────────────────────
# Install labor added to every shade, before overhead and profit.
SHADE_LABOR_PER_UNIT=65
# Markups applied only when no Bid Summary grand total is available. A bid total
# is already a sell price, so it is used as-is with no markup added.
ESTIMATE_OVERHEAD_PCT=10
ESTIMATE_PROFIT_PCT=8
# Reference opening for the size factor: 4'0" × 6'0" = 24 sq ft. A 48 sq ft
# opening prices at 2× the catalogue list price for material.
SHADE_NOMINAL_SQFT=24

# ── Vision (full analysis route only) ────────────────────────────────────────
VISION_ANALYZE_ALL=true
VISION_HARD_PAGE_CAP=200
VISION_MAX_PDF_PAGES=0
VISION_PDF_DPI=144
VISION_PAGES_PER_REQUEST=2
VISION_PARALLEL_REQUESTS=4

# Optional: override default shade catalogue (JSON array of SKU objects)
# CATALOGUE_JSON_PATH=data/catalogue.json
